FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DATA_DIR=/data \
    DATABASE_URL=sqlite:////data/jobeval.db \
    UPLOAD_DIR=/data/uploads \
    OUTPUT_DIR=/data/reports

# OCP/OpenGL runtime libraries used by the OCCT Python bindings.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libgl1 libglu1-mesa libxext6 libx11-6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend
COPY backend/pyproject.toml backend/README.md ./
COPY backend/app ./app
COPY fixtures /app/fixtures

RUN python -m pip install --upgrade pip \
    && python -m pip install .

RUN mkdir -p /data/uploads /data/reports
VOLUME ["/data"]

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
