# JobEval Environment Configuration
# Copy to .env and customize

# =============================================================================
# Application
# =============================================================================
APP_NAME=JobEval
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://jobeval:jobeval@localhost:5432/jobeval
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Celery
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# =============================================================================
# File Storage (MinIO/S3)
# =============================================================================
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=jobeval
STORAGE_SECURE=false
STORAGE_REGION=us-east-1
MAX_FILE_SIZE_MB=500

# =============================================================================
# File Paths
# =============================================================================
UPLOAD_DIR=/app/uploads
TEMP_DIR=/app/temp
OUTPUT_DIR=/app/outputs

# =============================================================================
# CAD Processing
# =============================================================================
OCCT_TOLERANCE=1e-6
OCCT_ANGULAR_TOLERANCE=0.01
MESH_DEFLECTION=0.1
MESH_ANGLE=0.5
ENABLE_GEOMETRY_REPAIR=true
REPAIR_TOLERANCE=1e-4

# Feature Recognition
MIN_HOLE_DIAMETER=0.5
MAX_HOLE_DIAMETER=500.0
MIN_FEATURE_CONFIDENCE=0.3
PATTERN_DETECTION_TOLERANCE=0.1
SYMMETRY_TOLERANCE=0.01

# Drawing Analysis
PDF_RENDER_DPI=300
OCR_LANGUAGES=en
OCR_CONFIDENCE_THRESHOLD=0.6
DIMENSION_DETECTION_CONFIDENCE=0.7

# Manufacturing
DEFAULT_MACHINE=generic_3axis
DEFAULT_MATERIAL=aluminum_6061
STOCK_MARGIN_MM=5.0
TOOL_CHANGE_TIME_S=15.0
SETUP_TIME_MIN=30.0
INSPECTION_TIME_PER_FEATURE_MIN=2.0

# =============================================================================
# LLM
# =============================================================================
LLM_PROVIDER=nvidia_nim
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-...
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
ENABLE_ZERO_DATA_RETENTION=true

# =============================================================================
# Privacy
# =============================================================================
PRIVACY_MODE=local
ALLOWED_PROVIDERS=openrouter,deepinfra,nvidia_nim
DATA_RETENTION_DAYS=30
AUTO_DELETE_PROCESSED_FILES=true

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=console