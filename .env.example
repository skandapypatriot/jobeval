# JobEval local configuration
# Copy to .env only when you need to override a default. Never commit real secrets.

# Application
APP_NAME=JobEval
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Browser origins allowed to call the local API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Local persistence (SQLite is the default zero-infrastructure profile).
DATABASE_URL=sqlite:///./.jobeval_data/jobeval.db
DATA_DIR=./.jobeval_data
UPLOAD_DIR=./.jobeval_data/uploads
OUTPUT_DIR=./.jobeval_data/reports
MAX_UPLOAD_SIZE_MB=50

# STEP/B-Rep analysis. build123d uses the OCP binding of OCCT.
MESH_DEFLECTION_MM=0.10
MESH_ANGULAR_TOLERANCE_RAD=0.30
MAX_TESSELLATION_TRIANGLES=250000
ENABLE_GEOMETRY_REPAIR=false

# Feature review. Candidates below the automatic-cost threshold need confirmation.
MIN_FEATURE_CONFIDENCE=0.50

# Stock and pricing defaults. These are sample assumptions, not live market rates.
DEFAULT_CURRENCY=INR
DEFAULT_STOCK_ALLOWANCE_MM=2.0
DEFAULT_MATERIAL_NAME=Aluminium 6061-T6 (sample)
DEFAULT_MATERIAL_DENSITY_KG_M3=2700
DEFAULT_MATERIAL_PRICE_PER_KG=0
DEFAULT_MACHINE_RATE_PER_HOUR=0
DEFAULT_LABOUR_RATE_PER_HOUR=0

# Drawing parsing. Embedded PDF text/vector and DXF entities do not require OCR.
PDF_RENDER_DPI=200
OCR_ENABLED=false
OCR_LANGUAGE=eng

# Optional OpenRouter explanation. Leave blank to disable it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Future deployment adapters (not required by the local workflow).
POSTGRES_URL=
REDIS_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jobeval
